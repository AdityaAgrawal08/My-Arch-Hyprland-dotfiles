# ---------------------------
# System / Editor
# ---------------------------
.DS_Store
*.swp
*.swo

# ---------------------------
# Logs / Runtime state
# ---------------------------
*.log
logs/
state/
.cache/

# Autotheme thumbnail cache
hypr/.config/hypr/themes/wallpapers/thumbs/

# ---------------------------
# Python (pdfmerge etc.)
# ---------------------------
__pycache__/
*.pyc

# ---------------------------
# Package build artifacts (Arch)
# ---------------------------
*.pkg.tar.zst
*.pkg.tar.zst.sig

# ---------------------------
# Environments (explicit only)
# ---------------------------
.local/share/*/venv/

# ---------------------------
# Node (future-proof)
# ---------------------------
node_modules/

# ---------------------------
# Fish runtime state
# ---------------------------
fish/.config/fish/fish_variables
fish/.config/fish/conf.d/secrets.fish


# ---------------------------
# Backup files
# ---------------------------
*.backup

trash/.local/
*.db
*.lock


# ---------------------------
# Trash system (strict isolation)
# ---------------------------

# Absolute runtime path (critical)
.local/share/trash-system/

# Object store (defensive)
trash-system/objects/

# SQLite WAL / SHM (you enabled WAL)
*.db-wal
*.db-shm

# Lock files (more precise than *.lock alone)
*.db.lock
